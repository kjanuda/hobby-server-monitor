# Hobby Server Monitor
# Copy this file to .env and replace placeholder values.
# NEVER commit .env or any file containing real secrets.

# ---------------------------------------------------------------------------
# Bootstrap administrator
# ---------------------------------------------------------------------------

# This email is pre-created as the initial administrator.
# The Google account used to sign in must match this address.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com


# ---------------------------------------------------------------------------
# Google OAuth 2.0
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# For the local dashboard / systemd setup:
GOOGLE_REDIRECT_URI=http://localhost:4321/api/auth/google/callback


# ---------------------------------------------------------------------------
# Session and CSRF
# ---------------------------------------------------------------------------

SESSION_COOKIE_NAME=hsm_session

# Session lifetime in seconds. 28800 = 8 hours.
SESSION_TTL_SECONDS=28800

# false is required for plain HTTP localhost development.
# Set true when deploying behind HTTPS.
SESSION_COOKIE_SECURE=false

CSRF_COOKIE_NAME=hsm_csrf


# ---------------------------------------------------------------------------
# Metrics collector
# ---------------------------------------------------------------------------

# Poll LXD metrics every 10 seconds.
METRICS_INTERVAL_SECONDS=10

# Raw metric history retained by TinyFlux.
METRICS_RETENTION_HOURS=48

# TinyFlux CSV-backed database path, relative to the project root
# when services are run with the supplied systemd configuration.
METRICS_DB_PATH=backend/data/metrics.csv

# Container-side disk usage is more expensive than normal LXD metrics,
# so it is sampled less frequently and cached between measurements.
DISK_METRICS_INTERVAL_SECONDS=60


# ---------------------------------------------------------------------------
# Dashboard -> backend proxy
# ---------------------------------------------------------------------------

# Falcon API address used internally by the Astro server.
# It is intentionally bound to localhost.
HSM_BACKEND_URL=http://127.0.0.1:8000
