# Template rendered by deploy/install-systemd.sh

[Unit]
Description=Hobby Server Monitor Falcon API
After=snap.lxd.daemon.service network.target
Wants=snap.lxd.daemon.service

[Service]
Type=simple
User=__HSM_USER__
SupplementaryGroups=lxd
WorkingDirectory=__HSM_ROOT__/backend
EnvironmentFile=__HSM_ROOT__/.env
ExecStart=__HSM_ROOT__/backend/.venv/bin/python __HSM_ROOT__/backend/app.py
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
