[Unit]
Description=Hobby Server Monitor Metrics Collector
After=snap.lxd.daemon.service network.target
Wants=snap.lxd.daemon.service

[Service]
Type=simple
User=januda
SupplementaryGroups=lxd
WorkingDirectory=/home/januda/projects/hobby-server-monitor/backend
ExecStart=/home/januda/projects/hobby-server-monitor/backend/.venv/bin/python /home/januda/projects/hobby-server-monitor/backend/collector.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
