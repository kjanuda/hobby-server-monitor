      async function loadManagedAssignments(
        user: UserRecord,
      ) {
        if (!manageUserAssignments) {
          return;
        }

        if (user.role === "admin") {
          manageUserAssignments.innerHTML = `
            <div class="empty-state">
              Administrators already have access
              to every container.
            </div>
          `;

          return;
        }

        manageUserAssignments.textContent =
          "Loading assignments...";

        const assignmentData =
          await getUserAssignments(user.id);

        const assignedIds = new Set(
          assignmentData.containers.map(
            (container) => container.id,
          ),
        );

        if (!dashboardContainers.length) {
          manageUserAssignments.innerHTML = `
            <div class="empty-state">
              No containers are available.
            </div>
          `;

          return;
        }

        manageUserAssignments.innerHTML =
          dashboardContainers
            .map((container) => {
              if (container.container_id === null) {
                return "";
              }

              const assigned =
                assignedIds.has(
                  container.container_id,
                );

              const disabled =
                !user.active && !assigned;

              return `
                <div class="assignment-row">
                  <div>
                    <strong>
                      ${escapeText(
                        container.name,
                      )}
                    </strong>

                    <span>
                      ${escapeText(
                        container.status,
                      )}
                    </span>
                  </div>

                  <button
                    type="button"
                    class="secondary-button small assignment-toggle"
                    data-container-id="${
                      container.container_id
                    }"
                    data-assigned="${
                      assigned
                    }"
                    ${disabled ? "disabled" : ""}
                  >
                    ${
                      assigned
                        ? "Unassign"
                        : user.active
                          ? "Assign"
                          : "Revoked"
                    }
                  </button>
                </div>
              `;
            })
            .join("");
      }

      async function openManageUserModal(
        userId: number,
      ) {
        const user =
          dashboardUsers.find(
            (item) => item.id === userId,
          );

        if (!user) {
          return;
        }

        managedUserId = user.id;

        clearManageUserError();

        if (manageUserEmail) {
          manageUserEmail.value = user.email;
        }

        if (manageUserName) {
          manageUserName.value = user.name ?? "";
        }

        if (manageUserRole) {
          manageUserRole.value = user.role;
        }

        if (manageUserRam) {
          manageUserRam.value =
            bytesToGiB(
              user.ram_quota_bytes,
            );
        }

        if (manageUserCpu) {
          manageUserCpu.value =
            String(user.cpu_quota);
        }

        if (manageUserDisk) {
          manageUserDisk.value =
            bytesToGiB(
              user.disk_quota_bytes,
            );
        }

        if (revokeUserButton) {
          const isSelf =
            currentUserId === user.id;

          revokeUserButton.classList.toggle(
            "hidden",
            isSelf || !user.active,
          );
        }

        manageUserModal?.classList.remove(
          "hidden",
        );

        manageUserModal?.setAttribute(
          "aria-hidden",
          "false",
        );

        try {
          await loadManagedAssignments(user);
        } catch (error) {
          showManageUserError(
            error instanceof Error
              ? error.message
              : "Unable to load assignments.",
          );
        }
      }

      usersList?.addEventListener(
        "click",
        async (event) => {
          const target =
            event.target as HTMLElement;

          const button =
            target.closest(
              ".manage-user-button",
            ) as HTMLButtonElement | null;

          if (!button) {
            return;
          }

          const userId =
            Number(button.dataset.userId);

          if (!Number.isInteger(userId)) {
            return;
          }

          await openManageUserModal(userId);
        },
      );

      closeManageUserButton?.addEventListener(
        "click",
        closeManageUserModal,
      );

      cancelManageUserButton?.addEventListener(
        "click",
        closeManageUserModal,
      );

      manageUserModal?.addEventListener(
        "click",
        (event) => {
          if (
            event.target === manageUserModal
          ) {
            closeManageUserModal();
          }
        },
      );

      manageUserAssignments?.addEventListener(
        "click",
        async (event) => {
          const target =
            event.target as HTMLElement;

          const button =
            target.closest(
              ".assignment-toggle",
            ) as HTMLButtonElement | null;

          if (
            !button
            || managedUserId === null
          ) {
            return;
          }

          const containerId =
            Number(
              button.dataset.containerId,
            );

          const assigned =
            button.dataset.assigned
            === "true";

          if (
            !Number.isInteger(containerId)
          ) {
            return;
          }

          button.disabled = true;
          clearManageUserError();

          try {
            if (assigned) {
              await unassignContainerFromUser(
                managedUserId,
                containerId,
              );
            } else {
              await assignContainerToUser(
                managedUserId,
                containerId,
              );
            }

            const user =
              dashboardUsers.find(
                (item) =>
                  item.id === managedUserId,
              );

            if (user) {
              await loadManagedAssignments(
                user,
              );
            }
          } catch (error) {
            button.disabled = false;

            showManageUserError(
              error instanceof Error
                ? error.message
                : "Unable to update assignment.",
            );
          }
        },
      );

      manageUserForm?.addEventListener(
        "submit",
        async (event) => {
          event.preventDefault();

          if (
            managedUserId === null
            || !manageUserName
            || !manageUserRole
            || !manageUserRam
            || !manageUserCpu
            || !manageUserDisk
          ) {
            return;
          }

          const ramGiB =
            Number(manageUserRam.value);

          const cpuQuota =
            Number(manageUserCpu.value);

          const diskGiB =
            Number(manageUserDisk.value);

          if (
            !Number.isFinite(ramGiB)
            || !Number.isFinite(cpuQuota)
            || !Number.isFinite(diskGiB)
            || ramGiB < 0
            || cpuQuota < 0
            || diskGiB < 0
          ) {
            showManageUserError(
              "Quotas must be zero or positive numbers.",
            );

            return;
          }

          clearManageUserError();

          try {
            if (saveManageUserButton) {
              saveManageUserButton.disabled =
                true;

              saveManageUserButton.textContent =
                "Saving...";
            }

            await updateUser(
              managedUserId,
              {
                name:
                  manageUserName.value.trim(),
                role:
                  manageUserRole.value as
                    | "admin"
                    | "container_user",
                ram_quota_bytes:
                  gibToBytes(ramGiB),
                cpu_quota:
                  Math.floor(cpuQuota),
                disk_quota_bytes:
                  gibToBytes(diskGiB),
              },
            );

            closeManageUserModal();

            await loadDashboard();
          } catch (error) {
            showManageUserError(
              error instanceof Error
                ? error.message
                : "Unable to update user.",
            );
          } finally {
            if (saveManageUserButton) {
              saveManageUserButton.disabled =
                false;

              saveManageUserButton.textContent =
                "Save changes";
            }
          }
        },
      );

      revokeUserButton?.addEventListener(
        "click",
        async () => {
          if (managedUserId === null) {
            return;
          }

          const user =
            dashboardUsers.find(
              (item) =>
                item.id === managedUserId,
            );

          if (!user) {
            return;
          }

          const confirmed =
            window.confirm(
              `Revoke access for ${user.email}?`,
            );

          if (!confirmed) {
            return;
          }

          clearManageUserError();

          try {
            revokeUserButton.disabled = true;
            revokeUserButton.textContent =
              "Revoking...";

            await revokeUser(
              managedUserId,
            );

            closeManageUserModal();

            await loadDashboard();
          } catch (error) {
            showManageUserError(
              error instanceof Error
                ? error.message
                : "Unable to revoke user.",
            );
          } finally {
            revokeUserButton.disabled = false;
            revokeUserButton.textContent =
              "Revoke access";
          }
        },
      );

      document
        .querySelectorAll<HTMLElement>(
          ".nav-item",
        )
        .forEach((item) => {
          item.addEventListener(
            "click",
            () => {
              const section =
                item.dataset.section;

              if (section) {
                showSection(section);
              }
            },
          );
        });

      async function loadDashboard() {
        try {
          const auth =
            await getCurrentUser();

          loading?.classList.add(
            "hidden",
          );

          if (!auth) {
            login?.classList.remove(
              "hidden",
            );

            return;
          }

          currentUserId = auth.user.id;

          app?.classList.remove(
            "hidden",
          );

          if (sidebarName) {
            sidebarName.textContent =
              auth.user.name
              || auth.user.email;
          }

          if (sidebarRole) {
            sidebarRole.textContent =
              auth.user.role
                === "admin"
                ? "Administrator"
                : "Container User";
          }

          const containerData =
            await getContainers();

          dashboardContainers =
            containerData.containers;

          const containers =
            containerData.containers;

          const running =
            containers.filter(
              (container) =>
                container.status
                  .toLowerCase()
                === "running",
            ).length;

          const stopped =
            containers.length
            - running;

          if (totalCount) {
            totalCount.textContent =
              String(
                containers.length,
              );
          }

          if (runningCount) {
            runningCount.textContent =
              String(running);
          }

          if (stoppedCount) {
            stoppedCount.textContent =
              String(stopped);
          }

          const containerHtml =
            containers.length
              ? containers
                  .map(
                    containerMarkup,
                  )
                  .join("")
              : `
                  <div class="empty-state">
                    No containers available.
                  </div>
                `;

          if (containersList) {
            containersList.innerHTML =
              containerHtml;
          }

          if (overviewContainers) {
            overviewContainers.innerHTML =
              containers
                .slice(0, 5)
                .map(containerMarkup)
                .join("")
              || `
                <div class="empty-state">
                  No containers available.
                </div>
              `;
          }

          if (
            auth.user.role === "admin"
          ) {
            usersNav?.classList.remove(
              "hidden",
            );

            usersStat?.classList.remove(
              "hidden",
            );

            createButton?.classList.remove(
              "hidden",
            );

            const userData =
              await getUsers();

            dashboardUsers =
              userData.users;

            if (usersCount) {
              usersCount.textContent =
                String(
                  userData.count,
                );
            }

            if (usersList) {
              usersList.innerHTML =
                userData.users.length
                  ? userData.users
                      .map(userMarkup)
                      .join("")
                  : `
                    <div class="empty-state">
                      No users found.
                    </div>
                  `;
            }
          }
        } catch (cause) {
          loading?.classList.add(
            "hidden",
          );

          errorSection?.classList.remove(
            "hidden",
          );

          if (errorMessage) {
            errorMessage.textContent =
              cause instanceof Error
                ? cause.message
                : "Unknown error";
          }
        }
      }

      logoutButton?.addEventListener(
        "click",
        async () => {
          logoutButton.disabled = true;

          try {
            await logout();

            window.location.reload();
          } catch (cause) {
            alert(
              cause instanceof Error
                ? cause.message
                : "Logout failed",
            );

            logoutButton.disabled =
              false;
          }
        },
      );

      loadDashboard();
    </script>
  </body>
</html>

