      async function fetchJson(
        url: string,
        options?: RequestInit,
      ) {
        const response =
          await fetch(
            url,
            {
              credentials: "include",
              ...options,
              headers: {
                "Content-Type":
                  "application/json",
                ...(options?.headers ?? {}),
              },
            },
          );

        const contentType =
          response.headers.get(
            "content-type",
          ) ?? "";

        let payload: any = null;

        if (
          contentType.includes(
            "application/json",
          )
        ) {
          payload =
            await response.json();
        } else {
          const text =
            await response.text();

          payload = text
            ? {
                detail: text,
              }
            : null;
        }

        if (!response.ok) {
          const message =
            payload?.detail
            ?? payload?.message
            ?? payload?.error
            ?? `Request failed with status ${response.status}`;

          throw new Error(
            String(message),
          );
        }

        return payload;
      }

      function clearSelect(
        select: HTMLSelectElement | null,
      ) {
        if (!select) {
          return;
        }

        select.innerHTML = "";
      }

      function addSelectOption(
        select: HTMLSelectElement | null,
        value: string,
        label: string,
        selected = false,
      ) {
        if (!select) {
          return;
        }

        const option =
          document.createElement(
            "option",
          );

        option.value = value;
        option.textContent = label;
        option.selected = selected;

        select.appendChild(option);
      }

      async function loadCreateContainerOptions() {
        /*
         * The backend exposes container options
         * through /api/container-options.
         */
        try {
          if (containerImageInput) {
            containerImageInput.disabled =
              true;

            containerImageInput.innerHTML =
              `<option value="">Loading images...</option>`;
          }

          if (containerStorageInput) {
            containerStorageInput.disabled =
              true;

            containerStorageInput.innerHTML =
              `<option value="">Loading pools...</option>`;
          }

          if (containerNetworkInput) {
            containerNetworkInput.disabled =
              true;

            containerNetworkInput.innerHTML =
              `<option value="">Loading networks...</option>`;
          }

          const [
            options,
            host,
            usersData,
          ] = await Promise.all([
            fetchJson(
              "/api/container-options",
              {
                method: "GET",
              },
            ),
            fetchJson(
              "/api/host/resources",
              {
                method: "GET",
              },
            ),
            fetchJson(
              "/api/users",
              {
                method: "GET",
              },
            ),
          ]);

          /*
           * Images
           */
          const images =
            Array.isArray(
              options?.images,
            )
              ? options.images
              : [];

          clearSelect(
            containerImageInput,
          );

          if (!images.length) {
            addSelectOption(
              containerImageInput,
              "",
              "No images available",
            );
          } else {
            images.forEach(
              (
                image: any,
                index: number,
              ) => {
                const value =
                  typeof image === "string"
                    ? image
                    : (
                        image.alias
                        ?? image.name
                        ?? image.fingerprint
                        ?? image.id
                        ?? ""
                      );

                const label =
                  typeof image === "string"
                    ? image
                    : (
                        image.description
                        ?? image.title
                        ?? image.alias
                        ?? image.name
                        ?? value
                      );

                if (value) {
                  addSelectOption(
                    containerImageInput,
                    String(value),
                    String(label),
                    index === 0,
                  );
                }
              },
            );
          }

          /*
           * Storage pools
           */
          const storagePools =
            Array.isArray(
              options?.storage_pools,
            )
              ? options.storage_pools
              : Array.isArray(
                  options?.pools,
                )
                ? options.pools
                : [];

          clearSelect(
            containerStorageInput,
          );

          if (!storagePools.length) {
            addSelectOption(
              containerStorageInput,
              "",
              "No storage pools available",
            );
          } else {
            storagePools.forEach(
              (
                pool: any,
                index: number,
              ) => {
                const value =
                  typeof pool === "string"
                    ? pool
                    : (
                        pool.name
                        ?? pool.pool
                        ?? pool.id
                        ?? ""
                      );

                const label =
                  typeof pool === "string"
                    ? pool
                    : (
                        pool.name
                        ?? pool.description
                        ?? value
                      );

                if (value) {
                  addSelectOption(
                    containerStorageInput,
                    String(value),
                    String(label),
                    index === 0,
                  );
                }
              },
            );
          }

          if (storagePoolHint) {
            const poolCount =
              storagePools.length;

            storagePoolHint.textContent =
              poolCount
                ? `${poolCount} storage pool${poolCount === 1 ? "" : "s"} available.`
                : "";
          }

          /*
           * Networks
           */
          const networks =
            Array.isArray(
              options?.networks,
            )
              ? options.networks
              : [];

          clearSelect(
            containerNetworkInput,
          );

          if (!networks.length) {
            addSelectOption(
              containerNetworkInput,
              "",
              "No networks available",
            );
          } else {
            networks.forEach(
              (
                network: any,
                index: number,
              ) => {
                const value =
                  typeof network === "string"
                    ? network
                    : (
                        network.name
                        ?? network.network
                        ?? network.id
                        ?? ""
                      );

                const label =
                  typeof network === "string"
                    ? network
                    : (
                        network.name
                        ?? network.description
                        ?? value
                      );

                if (value) {
                  addSelectOption(
                    containerNetworkInput,
                    String(value),
                    String(label),
                    index === 0,
                  );
                }
              },
            );
          }

          /*
           * Host CPU information
           */
          const hostCpu =
            host?.cpu?.logical_cpus
            ?? host?.cpu?.cores
            ?? host?.logical_cpus
            ?? host?.cpu_cores
            ?? null;

          if (
            hostCpu !== null
            && hostCpu !== undefined
          ) {
            if (hostCpuHint) {
              hostCpuHint.textContent =
                `${hostCpu} logical CPU core${Number(hostCpu) === 1 ? "" : "s"} available.`;
            }

            if (containerCpuInput) {
              containerCpuInput.max =
                String(hostCpu);
            }
          } else if (hostCpuHint) {
            hostCpuHint.textContent =
              "Host capacity will be validated when creating.";
          }

          /*
           * Users / owners
           */
          const owners =
            Array.isArray(
              usersData?.users,
            )
              ? usersData.users
              : [];

          clearSelect(
            containerOwnerInput,
          );

          addSelectOption(
            containerOwnerInput,
            "",
            "No owner",
            true,
          );

          owners.forEach(
            (user: any) => {
              const userId =
                user.user_id
                ?? user.id;

              if (
                userId === null
                || userId === undefined
              ) {
                return;
              }

              const label =
                user.name
                || user.email
                || `User ${userId}`;

              addSelectOption(
                containerOwnerInput,
                String(userId),
                String(label),
              );
            },
          );

          if (containerImageInput) {
            containerImageInput.disabled =
              false;
          }

          if (containerStorageInput) {
            containerStorageInput.disabled =
              false;
          }

          if (containerNetworkInput) {
            containerNetworkInput.disabled =
              false;
          }
        } catch (cause) {
          const message =
            cause instanceof Error
              ? cause.message
              : "Unable to load container options.";

          if (containerImageInput) {
            containerImageInput.innerHTML =
              `<option value="">Unable to load images</option>`;
          }

          if (containerStorageInput) {
            containerStorageInput.innerHTML =
              `<option value="">Unable to load pools</option>`;
          }

          if (containerNetworkInput) {
            containerNetworkInput.innerHTML =
              `<option value="">Unable to load networks</option>`;
          }

          showCreateError(
            `Unable to load container options: ${message}`,
          );
        }
      }

      function parseInteger(
        value: string | null | undefined,
        fieldName: string,
      ) {
        const parsed =
          Number.parseInt(
            String(value ?? ""),
            10,
          );

        if (
          !Number.isFinite(parsed)
          || parsed < 1
        ) {
          throw new Error(
            `${fieldName} must be a positive integer.`,
          );
        }

        return parsed;
      }

      function normalizeFormData() {
        if (
          !createForm
          || !containerNameInput
          || !containerImageInput
          || !containerMemoryInput
          || !containerCpuInput
          || !containerCpuAllowanceInput
          || !containerDiskInput
          || !containerStorageInput
          || !containerNetworkInput
        ) {
          throw new Error(
            "Create container form is not available.",
          );
        }

        if (
          !createForm.reportValidity()
        ) {
          return null;
        }

        const name =
          containerNameInput.value.trim();

        const image =
          containerImageInput.value.trim();

        const memory =
          containerMemoryInput.value.trim();

        const cpuCores =
          parseInteger(
            containerCpuInput.value,
            "CPU cores",
          );

        const cpuAllowance =
          parseInteger(
            containerCpuAllowanceInput.value,
            "CPU allowance",
          );

        const disk =
          containerDiskInput.value.trim();

        const storagePool =
          containerStorageInput.value.trim();

        const network =
          containerNetworkInput.value.trim();

        const ownerValue =
          containerOwnerInput?.value
            ?.trim()
          || "";

        const description =
          containerDescriptionInput
            ?.value
            ?.trim()
          || "";

        const autostart =
          containerAutostartInput
            ?.checked
          ?? true;

        const ephemeral =
          containerEphemeralInput
            ?.checked
          ?? false;

        if (!name) {
          throw new Error(
            "Container name is required.",
          );
        }

        if (!image) {
          throw new Error(
            "Please select an Ubuntu image.",
          );
        }

        if (!memory) {
          throw new Error(
            "Memory is required.",
          );
        }

        if (!disk) {
          throw new Error(
            "Disk limit is required.",
          );
        }

        if (!storagePool) {
          throw new Error(
            "Please select a storage pool.",
          );
        }

        if (!network) {
          throw new Error(
            "Please select a network.",
          );
        }

        /*
         * Keep the field names aligned with
         * the backend create-container API.
         */
        const payload: Record<
          string,
          unknown
        > = {
          name,
          image,
          memory,
          cpu_cores: cpuCores,
          cpu_allowance: cpuAllowance,
          disk,
          storage_pool: storagePool,
          network,
          description,
          autostart,
          ephemeral,
        };

        if (ownerValue) {
          payload.owner_user_id =
            Number.parseInt(
              ownerValue,
              10,
            );
        }

        return payload;
      }

      async function createContainer() {
        clearCreateError();

        try {
          const payload =
            normalizeFormData();

          if (!payload) {
            return;
          }

          if (createSubmitButton) {
            createSubmitButton.disabled =
              true;

            createSubmitButton.textContent =
              "Creating...";
          }

          await createContainerRequest(
            payload as any,
          );

          closeCreateModal();

          /*
           * Reload dashboard data so the
           * newly-created container appears.
           */
          await loadDashboard();
        } catch (cause) {
          const message =
            cause instanceof Error
              ? cause.message
              : "Failed to create container.";

          showCreateError(
            message,
          );
        } finally {
          if (createSubmitButton) {
            createSubmitButton.disabled =
              false;

            createSubmitButton.textContent =
              "Create container";
          }
        }
      }

