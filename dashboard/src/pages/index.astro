      inviteUserForm?.addEventListener(
        "submit",
        async (event) => {
          event.preventDefault();

          if (
            !inviteEmailInput
            || !inviteNameInput
            || !inviteRoleInput
            || !inviteRamQuotaInput
            || !inviteCpuQuotaInput
            || !inviteDiskQuotaInput
          ) {
            return;
          }

          const submitButton =
            document.querySelector<HTMLButtonElement>(
              "#submit-invite-user",
            );

          if (inviteUserError) {
            inviteUserError.textContent = "";
            inviteUserError.classList.add("hidden");
          }

          const ramGiB = Number(
            inviteRamQuotaInput.value,
          );

          const cpuQuota = Number(
            inviteCpuQuotaInput.value,
          );

          const diskGiB = Number(
            inviteDiskQuotaInput.value,
          );

          if (
            !Number.isFinite(ramGiB)
            || !Number.isFinite(cpuQuota)
            || !Number.isFinite(diskGiB)
            || ramGiB < 0
            || cpuQuota < 0
            || diskGiB < 0
          ) {
            if (inviteUserError) {
              inviteUserError.textContent =
                "Quotas must be zero or positive numbers.";

              inviteUserError.classList.remove(
                "hidden",
              );
            }

            return;
          }

          try {
            if (submitButton) {
              submitButton.disabled = true;
              submitButton.textContent =
                "Inviting...";
            }

            await inviteUser({
              email: inviteEmailInput.value.trim(),
              name:
                inviteNameInput.value.trim()
                || undefined,
              role: inviteRoleInput.value as
                | "admin"
                | "container_user",
              ram_quota_bytes:
                gibToBytes(ramGiB),
              cpu_quota: Math.floor(cpuQuota),
              disk_quota_bytes:
                gibToBytes(diskGiB),
            });

            closeInviteUserModal();

            await loadDashboard();
          } catch (error) {
            if (inviteUserError) {
              inviteUserError.textContent =
                error instanceof Error
                  ? error.message
                  : "Unable to invite user.";

              inviteUserError.classList.remove(
                "hidden",
              );
            }
          } finally {
            if (submitButton) {
              submitButton.disabled = false;
              submitButton.textContent =
                "Invite user";
            }
          }
        },
      );

