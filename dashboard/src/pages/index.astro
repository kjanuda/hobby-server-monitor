---
const pageTitle = "Hobby Server Monitor";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <meta
      name="description"
      content="Secure LXD container monitoring dashboard"
    />
    <title>{pageTitle}</title>
  </head>

  <body>
    <div id="loading" class="center-screen">
      <div class="loader"></div>
      <p>Loading server...</p>
    </div>

    <main id="login" class="login hidden">
      <section class="login-card">
        <p class="eyebrow">
          On-premise infrastructure
        </p>

        <h1>
          Hobby Server
          <span>Monitor</span>
        </h1>

        <p class="muted">
          Securely monitor and control
          your LXD containers.
        </p>

        <a
          class="primary-button"
          href="/api/auth/google/login"
        >
          Continue with Google
        </a>
      </section>
    </main>

    <div
      id="app"
      class="app hidden"
    >
      <aside class="sidebar">
        <div>
          <div class="brand">
            <div class="brand-mark">H</div>

            <div>
              <strong>Hobby Server</strong>
              <span>Monitor</span>
            </div>
          </div>

          <nav class="nav">
            <button
              class="nav-item active"
              data-section="overview"
              type="button"
            >
              Overview
            </button>

            <button
              class="nav-item"
              data-section="containers"
              type="button"
            >
              Containers
            </button>

            <button
              id="users-nav"
              class="nav-item hidden"
              data-section="users"
              type="button"
            >
              Users
            </button>
          </nav>
        </div>

        <div class="sidebar-user">
          <div>
            <strong id="sidebar-name">
              —
            </strong>

            <span id="sidebar-role">
              —
            </span>
          </div>

          <button
            id="logout-button"
            class="logout-button"
            type="button"
          >
            Sign out
          </button>
        </div>
      </aside>

      <div class="content">
        <header class="header">
          <div>
            <p class="eyebrow">
              LXD infrastructure
            </p>

            <h2 id="page-heading">
              Overview
            </h2>
          </div>

          <div
            id="api-status"
            class="status-badge"
          >
            <span></span>
            Connected
          </div>
        </header>

        <section
          id="overview-section"
          class="section"
        >
          <div class="stats">
            <article class="stat-card">
              <span>Total containers</span>
              <strong id="total-count">—</strong>
            </article>

            <article class="stat-card">
              <span>Running</span>
              <strong id="running-count">—</strong>
            </article>

            <article class="stat-card">
              <span>Stopped</span>
              <strong id="stopped-count">—</strong>
            </article>

            <article
              id="users-stat"
              class="stat-card hidden"
            >
              <span>Users</span>
              <strong id="users-count">—</strong>
            </article>
          </div>

          <div class="panel">
            <div class="panel-heading">
              <div>
                <p class="eyebrow">
                  Infrastructure
                </p>

                <h3>Recent containers</h3>
              </div>
            </div>

            <div
              id="overview-containers"
              class="container-list"
            ></div>
          </div>
        </section>

        <section
          id="containers-section"
          class="section hidden"
        >
          <div class="panel">
            <div class="panel-heading">
              <div>
                <p class="eyebrow">
                  LXD
                </p>

                <h3>
                  Containers
                </h3>
              </div>

              <button
                id="create-container-button"
                class="primary-button small hidden"
                type="button"
              >
                New container
              </button>
            </div>

            <div
              id="containers-list"
              class="container-list"
            ></div>
          </div>
        </section>

        <section
          id="users-section"
          class="section hidden"
        >
          <div class="panel">
            <div class="panel-heading">
              <div>
                <p class="eyebrow">
                  Access control
                </p>

                <h3>
                  Users
                </h3>
              </div>

              <button
                id="invite-user-button"
                class="primary-button small"
                type="button"
              >
                Invite user
              </button>
            </div>

            <div
              id="users-list"
              class="users-list"
            ></div>
          </div>
        </section>

        <section
          id="error-section"
          class="error-panel hidden"
        >
          <strong>
            Unable to load dashboard
          </strong>

          <p id="error-message"></p>
        </section>
      </div>
    </div>

    <!-- Create Container Modal -->
    <div
      id="create-container-modal"
      class="modal-backdrop hidden"
      aria-hidden="true"
    >
      <div
        class="modal-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="create-container-title"
      >
        <div class="modal-header">
          <div>
            <p class="eyebrow">
              LXD provisioning
            </p>

            <h2 id="create-container-title">
              Create container
            </h2>

            <p class="modal-description">
              Configure resource limits and runtime options.
            </p>
          </div>

          <button
            id="close-create-container"
            class="icon-button"
            type="button"
            aria-label="Close"
          >
            ×
          </button>
        </div>

        <form id="create-container-form">
          <div class="form-grid">
            <label class="field">
              <span>Container name</span>

              <input
                id="container-name-input"
                name="name"
                type="text"
                placeholder="dev-server"
                minlength="1"
                maxlength="63"
                pattern="[a-z][a-z0-9-]*"
                required
              />

              <small>
                Lowercase letters, numbers and hyphens.
              </small>
            </label>

            <label class="field">
              <span>Ubuntu image</span>

              <select
                id="container-image-input"
                name="image"
                required
              >
                <option value="">
                  Loading images...
                </option>
              </select>
            </label>

            <label class="field">
              <span>Memory</span>

              <input
                id="container-memory-input"
                name="memory"
                type="text"
                value="512MiB"
                placeholder="512MiB"
                required
              />

              <small>
                Minimum 256 MiB.
              </small>
            </label>

            <label class="field">
              <span>CPU cores</span>

              <input
                id="container-cpu-input"
                name="cpu_cores"
                type="number"
                value="1"
                min="1"
                step="1"
                required
              />

              <small id="host-cpu-hint">
                Loading host capacity...
              </small>
            </label>

            <label class="field">
              <span>CPU allowance</span>

              <div class="input-suffix">
                <input
                  id="container-cpu-allowance-input"
                  name="cpu_allowance"
                  type="number"
                  value="100"
                  min="1"
                  max="100"
                  step="1"
                  required
                />

                <span>%</span>
              </div>
            </label>

            <label class="field">
              <span>Disk limit</span>

              <input
                id="container-disk-input"
                name="disk"
                type="text"
                value="5GiB"
                placeholder="5GiB"
                required
              />

              <small>
                Minimum 1 GiB.
              </small>
            </label>

            <label class="field">
              <span>Storage pool</span>

              <select
                id="container-storage-input"
                name="storage_pool"
                required
              >
                <option value="">
                  Loading pools...
                </option>
              </select>

              <small id="storage-pool-hint"></small>
            </label>

            <label class="field">
              <span>Network</span>

              <select
                id="container-network-input"
                name="network"
                required
              >
                <option value="">
                  Loading networks...
                </option>
              </select>
            </label>

            <label class="field full">
              <span>Owner</span>

              <select
                id="container-owner-input"
                name="owner_user_id"
              >
                <option value="">
                  No owner
                </option>
              </select>

              <small>
                Optional. Resource quotas are enforced
                for the selected owner.
              </small>
            </label>

            <label class="field full">
              <span>Description</span>

              <textarea
                id="container-description-input"
                name="description"
                rows="3"
                placeholder="Testing environment"
              ></textarea>
            </label>
          </div>

          <div class="toggle-grid">
            <label class="toggle-row">
              <input
                id="container-autostart-input"
                name="autostart"
                type="checkbox"
                checked
              />

              <span>
                <strong>Autostart</strong>
                <small>
                  Start automatically when the host boots.
                </small>
              </span>
            </label>

            <label class="toggle-row">
              <input
                id="container-ephemeral-input"
                name="ephemeral"
                type="checkbox"
              />

              <span>
                <strong>Ephemeral</strong>
                <small>
                  Remove the container after it stops.
                </small>
              </span>
            </label>
          </div>

          <div
            id="create-container-error"
            class="form-error hidden"
          ></div>

          <div class="modal-footer">
            <button
              id="cancel-create-container"
              class="secondary-button"
              type="button"
            >
              Cancel
            </button>

            <button
              id="submit-create-container"
              class="primary-button"
              type="submit"
            >
              Create container
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Invite User Modal -->
    <div
      id="invite-user-modal"
      class="modal-backdrop hidden"
      aria-hidden="true"
    >
      <div
        class="modal-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="invite-user-title"
      >
        <div class="modal-header">
          <div>
            <p class="eyebrow">
              Access control
            </p>

            <h2 id="invite-user-title">
              Invite user
            </h2>

            <p class="modal-description">
              Invite a Google account and configure resource quotas.
            </p>
          </div>

          <button
            id="close-invite-user"
            class="icon-button"
            type="button"
            aria-label="Close"
          >
            ×
          </button>
        </div>

        <form id="invite-user-form">
          <div class="form-grid">
            <label class="field full">
              <span>Email address</span>

              <input
                id="invite-email"
                type="email"
                placeholder="user@example.com"
                required
              />

              <small>
                Must match the Google account used to sign in.
              </small>
            </label>

            <label class="field">
              <span>Name</span>

              <input
                id="invite-name"
                type="text"
                placeholder="Optional display name"
              />
            </label>

            <label class="field">
              <span>Role</span>

              <select
                id="invite-role"
                required
              >
                <option value="container_user">
                  Container user
                </option>

                <option value="admin">
                  Admin
                </option>
              </select>
            </label>

            <label class="field">
              <span>RAM quota</span>

              <div class="input-suffix">
                <input
                  id="invite-ram-quota"
                  type="number"
                  min="0"
                  step="0.25"
                  value="0"
                  required
                />

                <span>GiB</span>
              </div>

              <small>
                0 = unlimited.
              </small>
            </label>

            <label class="field">
              <span>CPU quota</span>

              <input
                id="invite-cpu-quota"
                type="number"
                min="0"
                step="1"
                value="0"
                required
              />

              <small>
                0 = unlimited.
              </small>
            </label>

            <label class="field full">
              <span>Disk quota</span>

              <div class="input-suffix">
                <input
                  id="invite-disk-quota"
                  type="number"
                  min="0"
                  step="1"
                  value="0"
                  required
                />

                <span>GiB</span>
              </div>

              <small>
                0 = unlimited.
              </small>
            </label>
          </div>

          <div
            id="invite-user-error"
            class="form-error hidden"
          ></div>

          <div class="modal-footer">
            <button
              id="cancel-invite-user"
              class="secondary-button"
              type="button"
            >
              Cancel
            </button>

            <button
              id="submit-invite-user"
              class="primary-button"
              type="submit"
            >
              Invite user
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Manage User Modal -->
    <div
      id="manage-user-modal"
      class="modal-backdrop hidden"
      aria-hidden="true"
    >
      <div
        class="modal-card manage-user-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="manage-user-title"
      >
        <div class="modal-header">
          <div>
            <p class="eyebrow">
              Access control
            </p>

            <h2 id="manage-user-title">
              Manage user
            </h2>

            <p class="modal-description">
              Update quotas and container access.
            </p>
          </div>

          <button
            id="close-manage-user"
            class="icon-button"
            type="button"
            aria-label="Close"
          >
            ×
          </button>
        </div>

        <form id="manage-user-form">
          <div class="form-grid">
            <label class="field full">
              <span>Email address</span>

              <input
                id="manage-user-email"
                type="email"
                readonly
              />
            </label>

            <label class="field">
              <span>Name</span>

              <input
                id="manage-user-name"
                type="text"
              />
            </label>

            <label class="field">
              <span>Role</span>

              <select
                id="manage-user-role"
                required
              >
                <option value="container_user">
                  Container user
                </option>

                <option value="admin">
                  Admin
                </option>
              </select>
            </label>

            <label class="field">
              <span>RAM quota</span>

              <div class="input-suffix">
                <input
                  id="manage-user-ram"
                  type="number"
                  min="0"
                  step="0.25"
                  required
                />

                <span>GiB</span>
              </div>

              <small>
                0 = unlimited.
              </small>
            </label>

            <label class="field">
              <span>CPU quota</span>

              <input
                id="manage-user-cpu"
                type="number"
                min="0"
                step="1"
                required
              />

              <small>
                0 = unlimited.
              </small>
            </label>

            <label class="field full">
              <span>Disk quota</span>

              <div class="input-suffix">
                <input
                  id="manage-user-disk"
                  type="number"
                  min="0"
                  step="0.25"
                  required
                />

                <span>GiB</span>
              </div>

              <small>
                0 = unlimited.
              </small>
            </label>
          </div>

          <div class="assignment-section">
            <div>
              <p class="eyebrow">
                Container access
              </p>

              <h3>
                Assignments
              </h3>
            </div>

            <div
              id="manage-user-assignments"
              class="assignment-list"
            >
              Loading assignments...
            </div>
          </div>

          <div
            id="manage-user-error"
            class="form-error hidden"
          ></div>

          <div class="modal-footer">
            <button
              id="revoke-user-button"
              class="secondary-button danger-button"
              type="button"
            >
              Revoke access
            </button>

            <button
              id="cancel-manage-user"
              class="secondary-button"
              type="button"
            >
              Cancel
            </button>

            <button
              id="save-manage-user"
              class="primary-button"
              type="submit"
            >
              Save changes
            </button>
          </div>
        </form>
      </div>
    </div>

    <script>
      import {
        getContainers,
        getCurrentUser,
        createContainer as createContainerRequest,
        getUsers,
        inviteUser,
        updateUser,
        revokeUser,
        getUserAssignments,
        assignContainerToUser,
        unassignContainerFromUser,
        logout,
        type ContainerSummary,
        type UserRecord,
      } from "../lib/api";

      const loading =
        document.querySelector<HTMLElement>(
          "#loading",
        );

      const login =
        document.querySelector<HTMLElement>(
          "#login",
        );

      const app =
        document.querySelector<HTMLElement>(
          "#app",
        );

      const usersNav =
        document.querySelector<HTMLElement>(
          "#users-nav",
        );

      const usersStat =
        document.querySelector<HTMLElement>(
          "#users-stat",
        );

      const createButton =
        document.querySelector<HTMLButtonElement>(
          "#create-container-button",
        );

      const sidebarName =
        document.querySelector<HTMLElement>(
          "#sidebar-name",
        );

      const sidebarRole =
        document.querySelector<HTMLElement>(
          "#sidebar-role",
        );

      const totalCount =
        document.querySelector<HTMLElement>(
          "#total-count",
        );

      const runningCount =
        document.querySelector<HTMLElement>(
          "#running-count",
        );

      const stoppedCount =
        document.querySelector<HTMLElement>(
          "#stopped-count",
        );

      const usersCount =
        document.querySelector<HTMLElement>(
          "#users-count",
        );

      const containersList =
        document.querySelector<HTMLElement>(
          "#containers-list",
        );

      const overviewContainers =
        document.querySelector<HTMLElement>(
          "#overview-containers",
        );

      const usersList =
        document.querySelector<HTMLElement>(
          "#users-list",
        );

      const logoutButton =
        document.querySelector<HTMLButtonElement>(
          "#logout-button",
        );

      const errorSection =
        document.querySelector<HTMLElement>(
          "#error-section",
        );

      const errorMessage =
        document.querySelector<HTMLElement>(
          "#error-message",
        );

      /*
       * Create container modal elements
       */
      const createModal =
        document.querySelector<HTMLElement>(
          "#create-container-modal",
        );

      const closeCreateButton =
        document.querySelector<HTMLButtonElement>(
          "#close-create-container",
        );

      const cancelCreateButton =
        document.querySelector<HTMLButtonElement>(
          "#cancel-create-container",
        );

      const createForm =
        document.querySelector<HTMLFormElement>(
          "#create-container-form",
        );

      const createSubmitButton =
        document.querySelector<HTMLButtonElement>(
          "#submit-create-container",
        );

      const createError =
        document.querySelector<HTMLElement>(
          "#create-container-error",
        );

      const containerNameInput =
        document.querySelector<HTMLInputElement>(
          "#container-name-input",
        );

      const containerImageInput =
        document.querySelector<HTMLSelectElement>(
          "#container-image-input",
        );

      const containerMemoryInput =
        document.querySelector<HTMLInputElement>(
          "#container-memory-input",
        );

      const containerCpuInput =
        document.querySelector<HTMLInputElement>(
          "#container-cpu-input",
        );

      const containerCpuAllowanceInput =
        document.querySelector<HTMLInputElement>(
          "#container-cpu-allowance-input",
        );

      const containerDiskInput =
        document.querySelector<HTMLInputElement>(
          "#container-disk-input",
        );

      const containerStorageInput =
        document.querySelector<HTMLSelectElement>(
          "#container-storage-input",
        );

      const containerNetworkInput =
        document.querySelector<HTMLSelectElement>(
          "#container-network-input",
        );

      const containerOwnerInput =
        document.querySelector<HTMLSelectElement>(
          "#container-owner-input",
        );

      const containerDescriptionInput =
        document.querySelector<HTMLTextAreaElement>(
          "#container-description-input",
        );

      const containerAutostartInput =
        document.querySelector<HTMLInputElement>(
          "#container-autostart-input",
        );

      const containerEphemeralInput =
        document.querySelector<HTMLInputElement>(
          "#container-ephemeral-input",
        );

      const hostCpuHint =
        document.querySelector<HTMLElement>(
          "#host-cpu-hint",
        );

      const storagePoolHint =
        document.querySelector<HTMLElement>(
          "#storage-pool-hint",
        );

      const inviteUserButton =
        document.querySelector<HTMLButtonElement>(
          "#invite-user-button",
        );

      const inviteUserModal =
        document.querySelector<HTMLElement>(
          "#invite-user-modal",
        );

      const closeInviteUserButton =
        document.querySelector<HTMLButtonElement>(
          "#close-invite-user",
        );

      const cancelInviteUserButton =
        document.querySelector<HTMLButtonElement>(
          "#cancel-invite-user",
        );

      const inviteUserForm =
        document.querySelector<HTMLFormElement>(
          "#invite-user-form",
        );

      const inviteUserError =
        document.querySelector<HTMLElement>(
          "#invite-user-error",
        );

      const inviteEmailInput =
        document.querySelector<HTMLInputElement>(
          "#invite-email",
        );

      const inviteNameInput =
        document.querySelector<HTMLInputElement>(
          "#invite-name",
        );

      const inviteRoleInput =
        document.querySelector<HTMLSelectElement>(
          "#invite-role",
        );

      const inviteRamQuotaInput =
        document.querySelector<HTMLInputElement>(
          "#invite-ram-quota",
        );

      const inviteCpuQuotaInput =
        document.querySelector<HTMLInputElement>(
          "#invite-cpu-quota",
        );

      const inviteDiskQuotaInput =
        document.querySelector<HTMLInputElement>(
          "#invite-disk-quota",
        );

      const manageUserModal =
        document.querySelector<HTMLElement>(
          "#manage-user-modal",
        );

      const closeManageUserButton =
        document.querySelector<HTMLButtonElement>(
          "#close-manage-user",
        );

      const cancelManageUserButton =
        document.querySelector<HTMLButtonElement>(
          "#cancel-manage-user",
        );

      const manageUserForm =
        document.querySelector<HTMLFormElement>(
          "#manage-user-form",
        );

      const manageUserEmail =
        document.querySelector<HTMLInputElement>(
          "#manage-user-email",
        );

      const manageUserName =
        document.querySelector<HTMLInputElement>(
          "#manage-user-name",
        );

      const manageUserRole =
        document.querySelector<HTMLSelectElement>(
          "#manage-user-role",
        );

      const manageUserRam =
        document.querySelector<HTMLInputElement>(
          "#manage-user-ram",
        );

      const manageUserCpu =
        document.querySelector<HTMLInputElement>(
          "#manage-user-cpu",
        );

      const manageUserDisk =
        document.querySelector<HTMLInputElement>(
          "#manage-user-disk",
        );

      const manageUserAssignments =
        document.querySelector<HTMLElement>(
          "#manage-user-assignments",
        );

      const manageUserError =
        document.querySelector<HTMLElement>(
          "#manage-user-error",
        );

      const revokeUserButton =
        document.querySelector<HTMLButtonElement>(
          "#revoke-user-button",
        );

      const saveManageUserButton =
        document.querySelector<HTMLButtonElement>(
          "#save-manage-user",
        );

      let dashboardUsers: UserRecord[] = [];
      let dashboardContainers: ContainerSummary[] = [];
      let managedUserId: number | null = null;
      let currentUserId: number | null = null;

      function escapeText(value: unknown) {
        return String(
          value ?? "",
        )
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function formatBytes(
        value?: number | null,
      ) {
        if (
          value === undefined
          || value === null
        ) {
          return "—";
        }

        const units = [
          "B",
          "KiB",
          "MiB",
          "GiB",
          "TiB",
        ];

        let size = value;
        let unit = 0;

        while (
          size >= 1024
          && unit < units.length - 1
        ) {
          size /= 1024;
          unit += 1;
        }

        return `${size.toFixed(
          unit === 0 ? 0 : 1,
        )} ${units[unit]}`;
      }

      function gibToBytes(value: number): number {
        return Math.round(
          value * 1024 * 1024 * 1024,
        );
      }

      function bytesToGiB(
        bytes: number,
      ): string {
        if (!bytes) {
          return "0";
        }

        const value =
          bytes / (1024 * 1024 * 1024);

        return Number.isInteger(value)
          ? String(value)
          : String(
              Number(value.toFixed(2)),
            );
      }

      function statusClass(
        status: string,
      ) {
        return status.toLowerCase()
          === "running"
          ? "running"
          : "stopped";
      }

