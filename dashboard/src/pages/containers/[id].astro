---
const { id } = Astro.params;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <title>
      Container | Hobby Server Monitor
    </title>
  </head>

  <body>
    <main
      id="page"
      data-container-id={id}
    >
      <header class="topbar">
        <div>
          <a
            href="/"
            class="back-link"
          >
            ← Back to dashboard
          </a>

          <p class="eyebrow">
            LXD Container
          </p>

          <h1 id="container-name">
            Loading...
          </h1>

          <p
            id="container-image"
            class="muted"
          >
          </p>
        </div>

        <div
          id="status"
          class="status-badge"
        >
          —
        </div>
      </header>

      <section class="grid">
        <article class="metric-card">
          <span>IPv4</span>
          <strong id="ipv4">—</strong>
        </article>

        <article class="metric-card">
          <span>Uptime</span>
          <strong id="uptime">—</strong>
        </article>

        <article class="metric-card">
          <span>Processes</span>
          <strong id="processes">—</strong>
        </article>

        <article class="metric-card">
          <span>Memory</span>
          <strong id="memory">—</strong>
        </article>

        <article class="metric-card">
          <span>Disk used</span>
          <strong id="disk">—</strong>
        </article>

        <article class="metric-card">
          <span>Network RX / TX</span>
          <strong id="network">—</strong>
        </article>
      </section>

      <section class="panel">
        <div class="panel-heading">
          <div>
            <p class="eyebrow">
              Runtime controls
            </p>

            <h2>
              Container actions
            </h2>
          </div>
        </div>

        <div
          id="actions"
          class="actions"
        >
          <button data-action="start">
            Start
          </button>

          <button data-action="stop">
            Stop
          </button>

          <button data-action="restart">
            Restart
          </button>

          <button data-action="freeze">
            Freeze
          </button>

          <button data-action="unfreeze">
            Unfreeze
          </button>

          <button
            id="edit-resources-button"
            type="button"
          >
            Edit resources
          </button>

          <button
            id="delete-container-button"
            class="danger-button"
            type="button"
          >
            Delete container
          </button>
        </div>

        <p
          id="action-message"
          class="message"
        ></p>
      </section>

      <!-- Metrics -->
      <section class="panel">
        <div class="panel-heading metrics-heading">
          <div>
            <p class="eyebrow">
              Historical telemetry
            </p>

            <h2>
              Performance
            </h2>
          </div>

          <div
            id="range-selector"
            class="range-selector"
          >
            <button data-hours="1">
              1h
            </button>

            <button
              data-hours="6"
              class="active"
            >
              6h
            </button>

            <button data-hours="24">
              24h
            </button>

            <button data-hours="48">
              48h
            </button>
          </div>
        </div>

        <div class="charts-grid">
          <article class="chart-card">
            <div class="chart-title">
              <span>
                CPU usage
              </span>

              <strong id="latest-cpu">
                —
              </strong>
            </div>

            <div
              id="cpu-chart"
              class="chart"
            ></div>
          </article>

          <article class="chart-card">
            <div class="chart-title">
              <span>
                Memory usage
              </span>

              <strong id="latest-memory">
                —
              </strong>
            </div>

            <div
              id="memory-chart"
              class="chart"
            ></div>
          </article>

          <article class="chart-card wide">
            <div class="chart-title">
              <span>
                Network throughput
              </span>

              <strong id="latest-network">
                —
              </strong>
            </div>

            <div
              id="network-chart"
              class="chart"
            ></div>

            <div class="legend">
              <span>
                <i class="rx-dot"></i>
                RX
              </span>

              <span>
                <i class="tx-dot"></i>
                TX
              </span>
            </div>
          </article>
        </div>

        <p
          id="metrics-message"
          class="message"
        ></p>
      </section>

      <!-- Terminal -->
      <section class="panel">
        <div class="panel-heading">
          <div>
            <p class="eyebrow">
              Container exec
            </p>

            <h2>
              Terminal
            </h2>
          </div>
        </div>

        <form
          id="terminal-form"
          class="terminal-form"
        >
          <div class="terminal-input-row">
            <span class="prompt">
              $
            </span>

            <input
              id="terminal-command"
              type="text"
              autocomplete="off"
              spellcheck="false"
              placeholder="uname -a"
              maxlength="1024"
            />

            <button
              id="terminal-run"
              type="submit"
            >
              Run
            </button>
          </div>
        </form>

        <div
          id="terminal-output"
          class="terminal-output"
        >
          <div class="terminal-empty">
            Run a command inside this container.
          </div>
        </div>

        <div class="terminal-footer">
          <span id="terminal-exit">
            Exit —
          </span>

          <span id="terminal-truncated"></span>
        </div>
      </section>

      <!-- Edit Resources Modal -->
      <div
        id="edit-resources-modal"
        class="modal-backdrop hidden"
        aria-hidden="true"
      >
        <div
          class="modal-card"
          role="dialog"
          aria-modal="true"
          aria-labelledby="edit-resources-title"
        >
          <div class="modal-header">
            <div>
              <p class="eyebrow">
                Resource limits
              </p>

              <h2 id="edit-resources-title">
                Edit resources
              </h2>
            </div>

            <button
              id="close-edit-resources"
              class="icon-button"
              type="button"
              aria-label="Close"
            >
              ×
            </button>
          </div>

          <form id="edit-resources-form">
            <div class="form-grid">
              <label class="field">
                <span>Memory</span>

                <input
                  id="edit-memory"
                  type="text"
                  required
                />

                <small>
                  Minimum 256 MiB.
                </small>
              </label>

              <label class="field">
                <span>CPU cores</span>

                <input
                  id="edit-cpu-cores"
                  type="number"
                  min="1"
                  step="1"
                  required
                />
              </label>

              <label class="field">
                <span>CPU allowance</span>

                <div class="input-suffix">
                  <input
                    id="edit-cpu-allowance"
                    type="number"
                    min="1"
                    max="100"
                    step="1"
                    required
                  />

                  <span>%</span>
                </div>
              </label>

              <label class="field">
                <span>Disk limit</span>

                <input
                  id="edit-disk"
                  type="text"
                  required
                />

                <small>
                  Disk size can be increased,
                  but not reduced.
                </small>
              </label>
            </div>

            <div
              id="edit-resources-error"
              class="form-error hidden"
            ></div>

            <div class="modal-footer">
              <button
                id="cancel-edit-resources"
                class="secondary-button"
                type="button"
              >
                Cancel
              </button>

              <button
                id="save-resources-button"
                type="submit"
              >
                Save changes
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Delete Container Modal -->
      <div
        id="delete-container-modal"
        class="modal-backdrop hidden"
        aria-hidden="true"
      >
        <div
          class="modal-card danger-modal"
          role="dialog"
          aria-modal="true"
          aria-labelledby="delete-container-title"
        >
          <div class="modal-header">
            <div>
              <p class="eyebrow">
                Destructive action
              </p>

              <h2 id="delete-container-title">
                Delete container
              </h2>
            </div>

            <button
              id="close-delete-container"
              class="icon-button"
              type="button"
              aria-label="Close"
            >
              ×
            </button>
          </div>

          <p class="delete-warning">
            This permanently removes the LXD
            container and its registry record.
          </p>

          <p class="delete-confirm-copy">
            Type
            <strong id="delete-confirm-name"></strong>
            to confirm.
          </p>

          <form id="delete-container-form">
            <label class="field">
              <span>Container name</span>

              <input
                id="delete-confirm-input"
                type="text"
                autocomplete="off"
                required
              />
            </label>

            <div
              id="delete-container-error"
              class="form-error hidden"
            ></div>

            <div class="modal-footer">
              <button
                id="cancel-delete-container"
                class="secondary-button"
                type="button"
              >
                Cancel
              </button>

              <button
                id="confirm-delete-button"
                class="danger-button"
                type="submit"
              >
                Delete permanently
              </button>
            </div>
          </form>
        </div>
      </div>

      <section
        id="error"
        class="error hidden"
      ></section>
    </main>

    <script>
      import {
        deleteContainer,
        executeTerminalCommand,
        getContainer,
        getContainerMetrics,
        getCurrentUser,
        runContainerAction,
        updateContainer,
        type ContainerSummary,
        type MetricPoint,
      } from "../../lib/api";

      const page =
        document.querySelector<HTMLElement>(
          "#page",
        );

      const rawId =
        page?.dataset.containerId;

      const containerId =
        Number(rawId);

      let currentContainer:
        ContainerSummary | null = null;

      const editButton =
        document.querySelector<HTMLButtonElement>(
          "#edit-resources-button",
        );

      const deleteButton =
        document.querySelector<HTMLButtonElement>(
          "#delete-container-button",
        );

      const editModal =
        document.querySelector<HTMLElement>(
          "#edit-resources-modal",
        );

      const deleteModal =
        document.querySelector<HTMLElement>(
          "#delete-container-modal",
        );

      const editForm =
        document.querySelector<HTMLFormElement>(
          "#edit-resources-form",
        );

      const deleteForm =
        document.querySelector<HTMLFormElement>(
          "#delete-container-form",
        );

      const editMemory =
        document.querySelector<HTMLInputElement>(
          "#edit-memory",
        );

      const editCpu =
        document.querySelector<HTMLInputElement>(
          "#edit-cpu-cores",
        );

      const editCpuAllowance =
        document.querySelector<HTMLInputElement>(
          "#edit-cpu-allowance",
        );

      const editDisk =
        document.querySelector<HTMLInputElement>(
          "#edit-disk",
        );

      const deleteConfirmInput =
        document.querySelector<HTMLInputElement>(
          "#delete-confirm-input",
        );

      function formatBytes(
        value?: number | null,
      ) {
        if (
          value === null
          || value === undefined
        ) {
          return "—";
        }

        const units = [
          "B",
          "KiB",
          "MiB",
          "GiB",
          "TiB",
        ];

        let size = value;
        let index = 0;

        while (
          size >= 1024
          && index < units.length - 1
        ) {
          size /= 1024;
          index += 1;
        }

        return `${size.toFixed(
          index === 0 ? 0 : 1,
        )} ${units[index]}`;
      }

      function formatUptime(
        seconds?: number | null,
      ) {
        if (
          seconds === null
          || seconds === undefined
        ) {
          return "—";
        }

        const totalMinutes =
          Math.floor(seconds / 60);

        const days =
          Math.floor(
            totalMinutes / 1440,
          );

        const hours =
          Math.floor(
            (totalMinutes % 1440)
            / 60,
          );

        const minutes =
          totalMinutes % 60;

        if (days > 0) {
          return `${days}d ${hours}h`;
        }

        if (hours > 0) {
          return `${hours}h ${minutes}m`;
        }

        return `${minutes}m`;
      }

      function setText(
        selector: string,
        value: string,
      ) {
        const element =
          document.querySelector<HTMLElement>(
            selector,
          );

        if (element) {
          element.textContent = value;
        }
      }

      function bytesToLimit(
        value?: number | null,
      ) {
        if (
          value === null
          || value === undefined
        ) {
          return "";
        }

        const gib = 1024 ** 3;
        const mib = 1024 ** 2;

        if (value % gib === 0) {
          return `${value / gib}GiB`;
        }

        if (value % mib === 0) {
          return `${value / mib}MiB`;
        }

        return `${value}B`;
      }

      function showModal(
        modal: HTMLElement | null,
      ) {
        modal?.classList.remove("hidden");

        modal?.setAttribute(
          "aria-hidden",
          "false",
        );
      }

      function hideModal(
        modal: HTMLElement | null,
      ) {
        modal?.classList.add("hidden");

        modal?.setAttribute(
          "aria-hidden",
          "true",
        );
      }

      function setFormError(
        selector: string,
        message = "",
      ) {
        const element =
          document.querySelector<HTMLElement>(
            selector,
          );

        if (!element) {
          return;
        }

        element.textContent = message;

        element.classList.toggle(
          "hidden",
          !message,
        );
      }

      let selectedHours = 6;

      function chartSvg(
        values: Array<number | null>,
        maximum?: number,
        secondary?: Array<number | null>,
      ) {
        const width = 600;
        const height = 170;
        const padding = 10;

        const validValues = [
          ...values,
          ...(secondary ?? []),
        ].filter(
          (value): value is number =>
            typeof value === "number"
            && Number.isFinite(value),
        );

        if (validValues.length < 2) {
          return `
            <div class="chart-empty">
              Not enough samples yet.
            </div>
          `;
        }

        const maxValue =
          maximum
          ?? Math.max(
            ...validValues,
            1,
          );

        function makePath(
          series: Array<number | null>,
        ) {
          const usable =
            Math.max(series.length - 1, 1);

          const points = series
            .map((value, index) => {
              if (
                value === null
                || !Number.isFinite(value)
              ) {
                return null;
              }

              const x =
                padding
                + (
                  index
                  / usable
                )
                * (
                  width
                  - padding * 2
                );

              const normalized =
                Math.min(
                  Math.max(
                    value / maxValue,
                    0,
                  ),
                  1,
                );

              const y =
                height
                - padding
                - normalized
                  * (
                    height
                    - padding * 2
                  );

              return `${x.toFixed(1)},${y.toFixed(1)}`;
            })
            .filter(Boolean);

          return points.join(" ");
        }

        const primaryPath =
          makePath(values);

        const secondaryPath =
          secondary
            ? makePath(secondary)
            : "";

        return `
          <svg
            viewBox="0 0 ${width} ${height}"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <line
              x1="0"
              y1="${height * 0.25}"
              x2="${width}"
              y2="${height * 0.25}"
              class="grid-line"
            />

            <line
              x1="0"
              y1="${height * 0.5}"
              x2="${width}"
              y2="${height * 0.5}"
              class="grid-line"
            />

            <line
              x1="0"
              y1="${height * 0.75}"
              x2="${width}"
              y2="${height * 0.75}"
              class="grid-line"
            />

            <polyline
              points="${primaryPath}"
              class="chart-line primary"
            />

            ${
              secondary
                ? `
                  <polyline
                    points="${secondaryPath}"
                    class="chart-line secondary"
                  />
                `
                : ""
            }
          </svg>
        `;
      }

      function formatRate(
        value?: number | null,
      ) {
        if (
          value === undefined
          || value === null
        ) {
          return "—";
        }

        return `${formatBytes(value)}/s`;
      }

      async function loadMetrics() {
        const message =
          document.querySelector<HTMLElement>(
            "#metrics-message",
          );

        if (message) {
          message.textContent =
            "Loading metrics...";
        }

        try {
          const metrics =
            await getContainerMetrics(
              containerId,
              selectedHours,
              180,
            );

          const points =
            metrics.points;

          const cpuValues =
            points.map(
              (point: MetricPoint) =>
                point.cpu_percent,
            );

          const memoryValues =
            points.map(
              (point: MetricPoint) =>
                point.memory_percent,
            );

          const rxValues =
            points.map(
              (point: MetricPoint) =>
                point.rx_bytes_per_second,
            );

          const txValues =
            points.map(
              (point: MetricPoint) =>
                point.tx_bytes_per_second,
            );

          const cpuChart =
            document.querySelector<HTMLElement>(
              "#cpu-chart",
            );

          const memoryChart =
            document.querySelector<HTMLElement>(
              "#memory-chart",
            );

          const networkChart =
            document.querySelector<HTMLElement>(
              "#network-chart",
            );

          if (cpuChart) {
            cpuChart.innerHTML =
              chartSvg(
                cpuValues,
                100,
              );
          }

          if (memoryChart) {
            memoryChart.innerHTML =
              chartSvg(
                memoryValues,
                100,
              );
          }

          if (networkChart) {
            networkChart.innerHTML =
              chartSvg(
                rxValues,
                undefined,
                txValues,
              );
          }

          const latest =
            points.at(-1);

          setText(
            "#latest-cpu",
            latest?.cpu_percent !== null
            && latest?.cpu_percent !== undefined
              ? `${latest.cpu_percent.toFixed(1)}%`
              : "—",
          );

          setText(
            "#latest-memory",
            latest?.memory_percent !== null
            && latest?.memory_percent !== undefined
              ? `${latest.memory_percent.toFixed(1)}%`
              : "—",
          );

          setText(
            "#latest-network",
            latest
              ? (
                `${formatRate(
                  latest.rx_bytes_per_second,
                )} / ${formatRate(
                  latest.tx_bytes_per_second,
                )}`
              )
              : "—",
          );

          if (message) {
            message.textContent =
              `${metrics.sample_count} samples · `
              + `${metrics.returned_count} plotted`;
          }
        } catch (cause) {
          if (message) {
            message.textContent =
              cause instanceof Error
                ? cause.message
                : "Unable to load metrics.";
          }
        }
      }

      document
        .querySelectorAll<HTMLButtonElement>(
          "[data-hours]",
        )
        .forEach((button) => {
          button.addEventListener(
            "click",
            async () => {
              const value =
                Number(
                  button.dataset.hours,
                );

              if (
                ![1, 6, 24, 48]
                  .includes(value)
              ) {
                return;
              }

              selectedHours = value;

              document
                .querySelectorAll(
                  "[data-hours]",
                )
                .forEach((item) => {
                  item.classList.remove(
                    "active",
                  );
                });

              button.classList.add(
                "active",
              );

              await loadMetrics();
            },
          );
        });

      const terminalForm =
        document.querySelector<HTMLFormElement>(
          "#terminal-form",
        );

      const terminalInput =
        document.querySelector<HTMLInputElement>(
          "#terminal-command",
        );

      const terminalRun =
        document.querySelector<HTMLButtonElement>(
          "#terminal-run",
        );

      const terminalOutput =
        document.querySelector<HTMLElement>(
          "#terminal-output",
        );

      terminalForm?.addEventListener(
        "submit",
        async (event) => {
          event.preventDefault();

          const command =
            terminalInput?.value.trim()
            ?? "";

          if (!command) {
            return;
          }

          if (terminalRun) {
            terminalRun.disabled = true;
            terminalRun.textContent =
              "Running...";
          }

          if (terminalOutput) {
            terminalOutput.textContent =
              "";
          }

          try {
            const result =
              await executeTerminalCommand(
                containerId,
                command,
              );

            if (terminalOutput) {
              const stdout =
                document.createElement("pre");

              stdout.className =
                "terminal-stdout";

              stdout.textContent =
                result.stdout
                || (
                  result.stderr
                    ? ""
                    : "(no output)"
                );

              terminalOutput.appendChild(
                stdout,
              );

              if (result.stderr) {
                const stderr =
                  document.createElement("pre");

                stderr.className =
                  "terminal-stderr";

                stderr.textContent =
                  result.stderr;

                terminalOutput.appendChild(
                  stderr,
                );
              }
            }

            setText(
              "#terminal-exit",
              `Exit ${result.exit_code}`,
            );

            setText(
              "#terminal-truncated",
              result.truncated
                ? "Output truncated"
                : "",
            );
          } catch (cause) {
            if (terminalOutput) {
              terminalOutput.textContent =
                cause instanceof Error
                  ? cause.message
                  : "Command failed.";
            }

            setText(
              "#terminal-exit",
              "Exit —",
            );
          } finally {
            if (terminalRun) {
              terminalRun.disabled = false;
              terminalRun.textContent = "Run";
            }

            terminalInput?.focus();
          }
        },
      );

      async function loadContainer() {
        try {
          const auth =
            await getCurrentUser();

          if (!auth) {
            window.location.href = "/";
            return;
          }

          const data =
            await getContainer(
              containerId,
            );

          const container =
            data.container;

          currentContainer = container;

          setText(
            "#container-name",
            container.name,
          );

          setText(
            "#container-image",
            container.image?.description
              ?? "Unknown image",
          );

          setText(
            "#status",
            container.status,
          );

          setText(
            "#ipv4",
            container.ipv4
              ?? "No IPv4",
          );

          setText(
            "#uptime",
            formatUptime(
              container.uptime_seconds,
            ),
          );

          setText(
            "#processes",
            String(
              container.processes ?? 0,
            ),
          );

          const memoryUsed =
            formatBytes(
              container.memory
                ?.used_bytes,
            );

          const memoryPercent =
            container.memory
              ?.percent;

          setText(
            "#memory",
            memoryPercent !== null
            && memoryPercent !== undefined
              ? `${memoryUsed} (${memoryPercent.toFixed(1)}%)`
              : memoryUsed,
          );

          setText(
            "#disk",
            formatBytes(
              container.disk
                ?.used_bytes,
            ),
          );

          setText(
            "#network",
            `${formatBytes(
              container.network
                ?.rx_bytes,
            )} / ${formatBytes(
              container.network
                ?.tx_bytes,
            )}`,
          );

          const actions =
            document.querySelector<HTMLElement>(
              "#actions",
            );

          if (
            auth.user.role !== "admin"
          ) {
            actions?.classList.add(
              "hidden",
            );
          }
        } catch (cause) {
          const error =
            document.querySelector<HTMLElement>(
              "#error",
            );

          if (error) {
            error.textContent =
              cause instanceof Error
                ? cause.message
                : "Unable to load container.";

            error.classList.remove(
              "hidden",
            );
          }
        }
      }

      editButton?.addEventListener(
        "click",
        () => {
          if (!currentContainer) {
            return;
          }

          if (editMemory) {
            editMemory.value =
              currentContainer.limits.memory
              ?? "";
          }

          if (editCpu) {
            editCpu.value =
              currentContainer.limits.cpu
              ?? "1";
          }

          if (editCpuAllowance) {
            editCpuAllowance.value =
              String(
                Number.parseInt(
                  currentContainer
                    .limits
                    .cpu_allowance
                    ?? "100",
                  10,
                ),
              );
          }

          if (editDisk) {
            editDisk.value =
              bytesToLimit(
                currentContainer
                  .disk
                  ?.allocated_bytes,
              );
          }

          setFormError(
            "#edit-resources-error",
          );

          showModal(editModal);
        },
      );

      document
        .querySelector(
          "#close-edit-resources",
        )
        ?.addEventListener(
          "click",
          () => hideModal(editModal),
        );

      document
        .querySelector(
          "#cancel-edit-resources",
        )
        ?.addEventListener(
          "click",
          () => hideModal(editModal),
        );

      editForm?.addEventListener(
        "submit",
        async (event) => {
          event.preventDefault();

          if (
            !editMemory
            || !editCpu
            || !editCpuAllowance
            || !editDisk
          ) {
            return;
          }

          setFormError(
            "#edit-resources-error",
          );

          const saveButton =
            document.querySelector<HTMLButtonElement>(
              "#save-resources-button",
            );

          try {
            if (saveButton) {
              saveButton.disabled = true;
              saveButton.textContent =
                "Saving...";
            }

            await updateContainer(
              containerId,
              {
                memory:
                  editMemory.value.trim(),

                cpu_cores:
                  Number.parseInt(
                    editCpu.value,
                    10,
                  ),

                cpu_allowance:
                  Number.parseInt(
                    editCpuAllowance.value,
                    10,
                  ),

                disk:
                  editDisk.value.trim(),
              },
            );

            hideModal(editModal);

            await loadContainer();
          } catch (cause) {
            setFormError(
              "#edit-resources-error",
              cause instanceof Error
                ? cause.message
                : "Unable to update resources.",
            );
          } finally {
            if (saveButton) {
              saveButton.disabled = false;
              saveButton.textContent =
                "Save changes";
            }
          }
        },
      );

      deleteButton?.addEventListener(
        "click",
        () => {
          if (!currentContainer) {
            return;
          }

          setText(
            "#delete-confirm-name",
            currentContainer.name,
          );

          if (deleteConfirmInput) {
            deleteConfirmInput.value = "";
          }

          setFormError(
            "#delete-container-error",
          );

          showModal(deleteModal);
        },
      );

      document
        .querySelector(
          "#close-delete-container",
        )
        ?.addEventListener(
          "click",
          () => hideModal(deleteModal),
        );

      document
        .querySelector(
          "#cancel-delete-container",
        )
        ?.addEventListener(
          "click",
          () => hideModal(deleteModal),
        );

      deleteForm?.addEventListener(
        "submit",
        async (event) => {
          event.preventDefault();

          if (
            !currentContainer
            || !deleteConfirmInput
          ) {
            return;
          }

          const confirmation =
            deleteConfirmInput.value.trim();

          if (
            confirmation
            !== currentContainer.name
          ) {
            setFormError(
              "#delete-container-error",
              "Container name does not match.",
            );

            return;
          }

          const confirmButton =
            document.querySelector<HTMLButtonElement>(
              "#confirm-delete-button",
            );

          try {
            if (confirmButton) {
              confirmButton.disabled = true;
              confirmButton.textContent =
                "Deleting...";
            }

            await deleteContainer(
              containerId,
              confirmation,
            );

            window.location.href = "/";
          } catch (cause) {
            setFormError(
              "#delete-container-error",
              cause instanceof Error
                ? cause.message
                : "Unable to delete container.",
            );

            if (confirmButton) {
              confirmButton.disabled = false;
              confirmButton.textContent =
                "Delete permanently";
            }
          }
        },
      );

      document
        .querySelectorAll<HTMLButtonElement>(
          "[data-action]",
        )
        .forEach((button) => {
          button.addEventListener(
            "click",
            async () => {
              const action =
                button.dataset.action;

              if (!action) {
                return;
              }

              const message =
                document.querySelector<HTMLElement>(
                  "#action-message",
                );

              button.disabled = true;

              if (message) {
                message.textContent =
                  `Running ${action}...`;
              }

              try {
                await runContainerAction(
                  containerId,
                  action,
                );

                if (message) {
                  message.textContent =
                    `${action} completed successfully.`;
                }

                await loadContainer();
                await loadMetrics();
              } catch (cause) {
                if (message) {
                  message.textContent =
                    cause instanceof Error
                      ? cause.message
                      : "Action failed.";
                }
              } finally {
                button.disabled = false;
              }
            },
          );
        });

      loadMetrics();
      loadContainer();
    </script>
  </body>
</html>

